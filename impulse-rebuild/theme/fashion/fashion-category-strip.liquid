{%- comment -%}
  HIVOLT category strip — compact visual category tiles.
  Desktop: contained grid up to 6 across. Mobile: horizontal scroll-snap swipe.
  Labels are HTML below the image; anchors render only when a link is set.
{%- endcomment -%}

<div id="CatStrip-{{ section.id }}" class="cat-strip page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="cat-strip__heading h2">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="cat-strip__track">
    {%- for block in section.blocks -%}
      <div class="cat-strip__tile" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="cat-strip__link">{%- endif -%}
        <div class="cat-strip__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 480 }}"
              srcset="{{ block.settings.image | image_url: width: 320 }} 320w, {{ block.settings.image | image_url: width: 480 }} 480w, {{ block.settings.image | image_url: width: 640 }} 640w"
              sizes="(max-width: 767px) 40vw, 16vw"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
              loading="lazy">
          {%- else -%}
            <div class="cat-strip__placeholder"></div>
          {%- endif -%}
        </div>
        {%- if block.settings.label != blank -%}
          <p class="cat-strip__label">{{ block.settings.label | escape }}</p>
        {%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% style %}
  #CatStrip-{{ section.id }} { margin: 0 auto; }
  #CatStrip-{{ section.id }} .cat-strip__heading {
    margin: 0 0 16px;
  }
  #CatStrip-{{ section.id }} .cat-strip__track {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 8 }}, minmax(0, 1fr));
    gap: 10px;
  }
  #CatStrip-{{ section.id }} .cat-strip__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #F7F7F5;
  }
  #CatStrip-{{ section.id }} .cat-strip__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #CatStrip-{{ section.id }} .cat-strip__placeholder {
    width: 100%;
    height: 100%;
    background: #F7F7F5;
  }
  #CatStrip-{{ section.id }} .cat-strip__label {
    margin: 8px 0 0;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  #CatStrip-{{ section.id }} .cat-strip__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  @media (max-width: 767px) {
    #CatStrip-{{ section.id }} .cat-strip__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 8px;
      padding-bottom: 4px;
      scrollbar-width: none;
    }
    #CatStrip-{{ section.id }} .cat-strip__track::-webkit-scrollbar { display: none; }
    #CatStrip-{{ section.id }} .cat-strip__tile {
      flex: 0 0 38vw;
      scroll-snap-align: start;
    }
    #CatStrip-{{ section.id }} .cat-strip__label { font-size: 12px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Category strip",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (square crop)" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link (leave empty until the collection is live)" }
      ]
    }
  ],
  "presets": [ { "name": "Category strip" } ]
}
{% endschema %}
