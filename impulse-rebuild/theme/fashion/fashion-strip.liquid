{%- comment -%}
  HIVOLT brand strip — thin promotional line, true claims only.
  All text is HTML; tight vertical footprint for fast-fashion rhythm.
{%- endcomment -%}

<div class="fashion-strip fashion-strip--{{ section.settings.scheme }}">
  <p class="fashion-strip__text">{{ section.settings.text | escape }}</p>
</div>

{% style %}
  .fashion-strip {
    padding: 14px 20px;
    text-align: center;
  }
  .fashion-strip--dark { background: #0A0A0B; color: #ffffff; }
  .fashion-strip--forest { background: #0E3B2E; color: #F6F3EC; }
  .fashion-strip--light { background: #F7F7F5; color: #0A0A0B; }
  .fashion-strip__text {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.5;
  }
  @media (max-width: 767px) {
    .fashion-strip { padding: 12px 16px; }
    .fashion-strip__text { font-size: 12px; letter-spacing: 0.1em; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand strip",
  "class": "index-section--flush",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free tracked US shipping · 60-day free returns" },
    { "type": "select", "id": "scheme", "label": "Color scheme", "default": "dark", "options": [
      { "value": "dark", "label": "Dark" },
      { "value": "forest", "label": "Forest" },
      { "value": "light", "label": "Light" }
    ] }
  ],
  "presets": [ { "name": "Brand strip" } ]
}
{% endschema %}
