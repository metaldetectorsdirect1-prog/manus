{%- comment -%}
  Category circles — quick discovery row under the hero (reference 1.5).
  Data-gated: a block renders only when its collection exists and has
  products, or when a manual image + link + label are all deliberately set.
  Ships empty; zero fake categories can render.
{%- endcomment -%}

{%- liquid
  assign qualified = 0
  for block in section.blocks
    assign c = block.settings.collection
    if c != blank and c.products_count > 0
      assign qualified = qualified | plus: 1
    elsif block.settings.image != blank and block.settings.link != blank and block.settings.label != blank
      assign qualified = qualified | plus: 1
    endif
  endfor
-%}

{%- if qualified > 0 -%}
<div class="fashion-circles page-width" data-count="{{ qualified }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="fashion-circles__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ul class="fashion-circles__track" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign ok = false
        assign url = blank
        assign label = block.settings.label
        assign img = block.settings.image
        if c != blank and c.products_count > 0
          assign ok = true
          assign url = c.url
          if label == blank
            assign label = c.title
          endif
          if img == blank
            assign img = c.featured_image
          endif
        elsif img != blank and block.settings.link != blank and label != blank
          assign ok = true
          assign url = block.settings.link
        endif
      -%}
      {%- if ok -%}
        <li class="fashion-circles__item{% if block.settings.highlight %} fashion-circles__item--highlight{% endif %}" {{ block.shopify_attributes }}>
          <a href="{{ url }}" class="fashion-circles__link">
            <span class="fashion-circles__disc">
              {%- if img != blank -%}
                {%- assign alt = img.alt | default: label -%}
                {{ img | image_url: width: 360 | image_tag: widths: '180, 360', sizes: '90px', alt: alt, loading: 'lazy' }}
              {%- endif -%}
            </span>
            <span class="fashion-circles__label">{{ label | escape }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% style %}
  .fashion-circles { padding: 26px 20px 6px; }
  .fashion-circles__heading { font-size: 22px; margin: 0 0 14px; }
  .fashion-circles__track {
    display: flex; gap: 8px; justify-content: center;
    list-style: none; margin: 0; padding: 0;
  }
  .fashion-circles__item { flex: 0 0 auto; }
  .fashion-circles__link {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; text-decoration: none; color: #0A0A0B;
    width: {{ section.settings.circle_size | plus: 24 }}px;
  }
  .fashion-circles__disc {
    width: {{ section.settings.circle_size }}px;
    height: {{ section.settings.circle_size }}px;
    border-radius: 50%; overflow: hidden; background: #F7F7F5;
    border: 1px solid #E4E4E4;
    transition: transform .18s ease;
  }
  .fashion-circles__disc img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fashion-circles__link:hover .fashion-circles__disc,
  .fashion-circles__link:focus-visible .fashion-circles__disc { transform: scale(1.04); }
  .fashion-circles__label {
    font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    text-align: center; line-height: 1.3;
  }
  .fashion-circles__item--highlight .fashion-circles__label { color: {{ section.settings.highlight_color }}; font-weight: 700; }
  @media (max-width: 767px) {
    .fashion-circles { padding: 20px 0 4px; }
    .fashion-circles__track {
      justify-content: flex-start; overflow-x: auto;
      scroll-snap-type: x proximity; padding: 0 16px 8px;
      -webkit-overflow-scrolling: touch;
    }
    .fashion-circles__item { scroll-snap-align: start; }
  }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Category circles",
  "class": "index-section--flush",
  "max_blocks": 10,
  "settings": [
    {
      "type": "paragraph",
      "content": "Quick category discovery row. A circle renders only when its collection exists and has products (or when image + link + label are all set manually). With no qualifying circles the section renders nothing."
    },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "range", "id": "circle_size", "label": "Circle size", "min": 56, "max": 104, "step": 4, "default": 84, "unit": "px" },
    { "type": "color", "id": "highlight_color", "label": "Highlight label color", "default": "#D0021B" }
  ],
  "blocks": [
    {
      "type": "circle",
      "name": "Circle",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override", "info": "Falls back to the collection image." },
        { "type": "text", "id": "label", "label": "Label override", "info": "Falls back to the collection title." },
        { "type": "url", "id": "link", "label": "Link override (manual mode)", "info": "Only used when no collection is chosen; requires image and label too." },
        { "type": "checkbox", "id": "highlight", "label": "Highlight label (e.g. Sale)", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Category circles" } ]
}
{% endschema %}
