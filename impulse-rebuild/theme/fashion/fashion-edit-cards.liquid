{%- comment -%}
  "The Edit" — editorial curation cards (reference 1.7).
  Four portrait cards, uppercase label + caption over a bottom gradient.
  Data-gated: a card renders only with an image AND a destination
  (collection or manual link). Ships empty.
{%- endcomment -%}

{%- liquid
  assign qualified = 0
  for block in section.blocks
    assign dest = block.settings.link
    if block.settings.collection != blank
      assign dest = block.settings.collection.url
    endif
    if block.settings.image != blank and dest != blank
      assign qualified = qualified | plus: 1
    endif
  endfor
-%}

{%- if qualified > 0 -%}
<div class="fashion-edits page-width">
  <div class="fashion-edits__head">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="fashion-edits__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="fashion-edits__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <a class="fashion-edits__all" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
  <div class="fashion-edits__grid fashion-edits__grid--{{ qualified }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign dest = block.settings.link
        if block.settings.collection != blank
          assign dest = block.settings.collection.url
        endif
      -%}
      {%- if block.settings.image != blank and dest != blank -%}
        <a class="fashion-edits__card" href="{{ dest }}" {{ block.shopify_attributes }}>
          {%- assign alt = block.settings.image.alt | default: block.settings.label -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(max-width: 767px) 50vw, 25vw', alt: alt, loading: 'lazy' }}
          <span class="fashion-edits__overlay">
            {%- if block.settings.label != blank -%}
              <span class="fashion-edits__label">{{ block.settings.label | escape }}</span>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <span class="fashion-edits__caption">{{ block.settings.caption | escape }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% style %}
  .fashion-edits { padding: 34px 20px 8px; }
  .fashion-edits__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .fashion-edits__title { font-size: 22px; margin: 0; }
  .fashion-edits__sub { font-size: 13px; color: #6B6B6B; margin: 4px 0 0; }
  .fashion-edits__all {
    font-size: 12px; letter-spacing: .12em; text-transform: uppercase;
    color: #0A0A0B; text-decoration: none; border-bottom: 1px solid #0A0A0B;
    padding-bottom: 2px; white-space: nowrap;
  }
  .fashion-edits__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .fashion-edits__grid--1 { grid-template-columns: 1fr; }
  .fashion-edits__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .fashion-edits__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .fashion-edits__card { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; background: #F7F7F5; }
  .fashion-edits__card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
  .fashion-edits__card:hover img, .fashion-edits__card:focus-visible img { transform: scale(1.03); }
  .fashion-edits__overlay {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 34px 14px 14px; display: flex; flex-direction: column; gap: 3px;
    background: linear-gradient(transparent, rgba(0,0,0,.5)); color: #fff;
  }
  .fashion-edits__label { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .fashion-edits__caption { font-size: 12px; opacity: .92; }
  @media (max-width: 767px) {
    .fashion-edits { padding: 26px 16px 4px; }
    .fashion-edits__grid, .fashion-edits__grid--3 { grid-template-columns: repeat(2, 1fr); }
  }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "The Edit cards",
  "class": "index-section--flush",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Editorial curation cards. A card renders only when it has an image and a destination. With no qualifying cards the section renders nothing."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Edit" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link (if no collection)" }
      ]
    }
  ],
  "presets": [ { "name": "The Edit cards" } ]
}
{% endschema %}
