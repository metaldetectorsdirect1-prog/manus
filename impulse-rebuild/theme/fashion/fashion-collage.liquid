{%- comment -%}
  HIVOLT collage v3 — deliberate merchandising composition.
  Desktop: one large dominant tile left, 4 complementary tiles right (2×2).
  Mobile: 2-column with the anchor full-width first.
  All frames from one shoot family; labels are HTML; anchors render only
  when a link is set.
{%- endcomment -%}

<div id="Collage-{{ section.id }}" class="fashion-collage page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="fashion-collage__heading h2">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="fashion-collage__grid">
    {%- for block in section.blocks -%}
      <div class="fashion-collage__tile {% if forloop.first %}fashion-collage__tile--anchor{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="fashion-collage__link">{%- endif -%}
        <div class="fashion-collage__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              srcset="{{ block.settings.image | image_url: width: 480 }} 480w, {{ block.settings.image | image_url: width: 750 }} 750w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
              sizes="{% if forloop.first %}(max-width: 767px) 100vw, 50vw{% else %}(max-width: 767px) 50vw, 25vw{% endif %}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
              loading="lazy">
          {%- else -%}
            <div class="fashion-collage__placeholder"></div>
          {%- endif -%}
        </div>
        {%- if block.settings.title != blank -%}
          <p class="fashion-collage__label">{{ block.settings.title | escape }}</p>
        {%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% style %}
  #Collage-{{ section.id }} .fashion-collage__heading {
    margin: 0 0 16px;
  }
  #Collage-{{ section.id }} .fashion-collage__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  #Collage-{{ section.id }} .fashion-collage__media {
    overflow: hidden;
    background: #F7F7F5;
  }
  #Collage-{{ section.id }} .fashion-collage__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #Collage-{{ section.id }} .fashion-collage__placeholder {
    width: 100%;
    height: 100%;
    min-height: 160px;
    background: #F7F7F5;
  }
  #Collage-{{ section.id }} .fashion-collage__label {
    margin: 8px 0 0;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  #Collage-{{ section.id }} .fashion-collage__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  /* Mobile: anchor full-width 4:5, others square in 2 columns */
  #Collage-{{ section.id }} .fashion-collage__tile--anchor { grid-column: 1 / -1; }
  #Collage-{{ section.id }} .fashion-collage__tile--anchor .fashion-collage__media { aspect-ratio: 4 / 5; }
  #Collage-{{ section.id }} .fashion-collage__tile:not(.fashion-collage__tile--anchor) .fashion-collage__media { aspect-ratio: 1 / 1; }
  @media (min-width: 768px) {
    #Collage-{{ section.id }} .fashion-collage__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: auto;
    }
    /* Dominant tile left spanning 2×2; four complementary tiles fill the right */
    #Collage-{{ section.id }} .fashion-collage__tile--anchor {
      grid-column: 1 / span 2;
      grid-row: 1 / span 2;
    }
    #Collage-{{ section.id }} .fashion-collage__tile--anchor .fashion-collage__media {
      aspect-ratio: auto;
      height: 100%;
    }
    #Collage-{{ section.id }} .fashion-collage__tile--anchor .fashion-collage__link,
    #Collage-{{ section.id }} .fashion-collage__tile--anchor .fashion-collage__media img {
      height: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Fashion collage",
  "max_blocks": 7,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the collection" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link (leave empty until the destination is live)" }
      ]
    }
  ],
  "presets": [ { "name": "Fashion collage" } ]
}
{% endschema %}
