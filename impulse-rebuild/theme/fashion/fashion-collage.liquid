{%- comment -%}
  HIVOLT category collage — asymmetric CSS grid. Anchor tile spans two rows
  on desktop; 2-column arrangement on mobile. Links render only when set.
{%- endcomment -%}

<div id="FashionCollage-{{ section.id }}" class="fashion-collage page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="fashion-collage__title">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="fashion-collage__grid">
    {%- for block in section.blocks -%}
      {%- assign tag = 'div' -%}
      {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
      <{{ tag }} {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        class="fashion-collage__tile{% if forloop.first %} fashion-collage__tile--anchor{% endif %}"
        {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 900 }}"
            srcset="{{ block.settings.image | image_url: width: 375 }} 375w, {{ block.settings.image | image_url: width: 550 }} 550w, {{ block.settings.image | image_url: width: 750 }} 750w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 767px) 50vw, 33vw"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
            loading="lazy">
        {%- else -%}
          <div class="fashion-collage__ph"></div>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <span class="fashion-collage__label">{{ block.settings.title | escape }}</span>
        {%- endif -%}
      </{{ tag }}>
    {%- endfor -%}
  </div>
</div>

{% style %}
  #FashionCollage-{{ section.id }} { margin-top: 28px; margin-bottom: 28px; }
  #FashionCollage-{{ section.id }} .fashion-collage__title {
    margin: 0 0 14px;
    font-size: 20px;
    letter-spacing: 0.04em;
  }
  #FashionCollage-{{ section.id }} .fashion-collage__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  #FashionCollage-{{ section.id }} .fashion-collage__tile {
    position: relative;
    display: block;
    overflow: hidden;
    background: #E9E6E0;
  }
  #FashionCollage-{{ section.id }} .fashion-collage__tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #FashionCollage-{{ section.id }} .fashion-collage__tile--anchor {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
  }
  #FashionCollage-{{ section.id }} .fashion-collage__tile:not(.fashion-collage__tile--anchor) {
    aspect-ratio: 1 / 1;
  }
  #FashionCollage-{{ section.id }} .fashion-collage__ph { width: 100%; height: 100%; }
  #FashionCollage-{{ section.id }} .fashion-collage__label {
    position: absolute;
    left: 12px;
    bottom: 10px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 1px 8px rgba(10,10,11,0.45);
  }
  a.fashion-collage__tile:hover img { transform: scale(1.02); }
  #FashionCollage-{{ section.id }} .fashion-collage__tile img { transition: transform 0.6s ease; }
  @media (prefers-reduced-motion: reduce) {
    #FashionCollage-{{ section.id }} .fashion-collage__tile img { transition: none; }
  }
  @media (min-width: 768px) {
    #FashionCollage-{{ section.id }} .fashion-collage__grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: minmax(0, 1fr);
    }
    #FashionCollage-{{ section.id }} .fashion-collage__tile--anchor {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
      aspect-ratio: auto;
      min-height: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Fashion collage",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link (only when a real destination exists)" }
      ]
    }
  ],
  "presets": [ { "name": "Fashion collage" } ]
}
{% endschema %}
