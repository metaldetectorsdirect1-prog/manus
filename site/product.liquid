{%- comment -%}
  HIVOLT — product template
  ─────────────────────────
  Drop-in replacement for templates/product.liquid.
  Requires assets/hivolt.css (linked from layout/theme.liquid).

  Specification rows are driven by metafields. A row that has no value is not
  rendered — never filled with a placeholder. The page's whole claim is that
  every number on it is real, and one invented figure destroys that on the first
  product a customer checks.

  Metafields (Settings → Custom data → Products):
    spec.gsm          integer            220
    spec.composition  single line text   75% nylon / 25% spandex
    spec.rise         single line text   High · 11.5"
    spec.inseam       single line text   31" (size M)
    spec.seams        single line text   Flatlock, 4-thread
    spec.gusset       single line text   Yes, diamond
    spec.opacity      single line text   Opaque under stretch
    spec.care         single line text   Cold wash · hang dry
{%- endcomment -%}

{%- assign m = product.metafields.spec -%}

{%- comment -%}
  One breadcrumb, used twice: once as the visible nav below and once as
  BreadcrumbList structured data further down. They are derived from the same
  `crumb` so they cannot disagree — Google treats structured data that claims a
  path the page does not show as a markup mismatch.

  `collection` is only in scope when the shopper arrived through a collection.
  On a direct /products/<handle> hit — which is what a search result opens, and
  therefore the case that matters for ranking — it is unset, and the page used
  to show a bare "Home > Product" with no category at all. Falling back to the
  product's own first real collection gives the page its category in both
  cases. `all` and `frontpage` are skipped: neither is a category a shopper
  would recognise as a step in the path.
{%- endcomment -%}
{%- assign crumb = collection -%}
{%- unless crumb.handle -%}
  {%- for c in product.collections -%}
    {%- unless c.handle == 'all' or c.handle == 'frontpage' -%}
      {%- assign crumb = c -%}
      {%- break -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endunless -%}

<nav class="crumb wrap" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {%- if crumb.handle -%}
      <li><a href="{{ crumb.url }}">{{ crumb.title }}</a></li>
    {%- endif -%}
    <li aria-current="page">{{ product.title }}</li>
  </ol>
</nav>

{%- comment -%}
  <main>, the ticker, masthead and footer come from layout/theme.liquid.
  This template supplies page content only.
{%- endcomment -%}

  <div class="pdp">

    <!-- gallery: supplier studio photography only -->
    <div class="gal">
      {%- capture gallery -%}
      {%- for media in product.media limit: 5 -%}
        {%- if media.media_type == 'image' -%}
          <div class="gal__f">
            <span class="gal__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <img
              src="{{ media | image_url: width: 1200 }}"
              srcset="{{ media | image_url: width: 600 }} 600w,
                      {{ media | image_url: width: 1200 }} 1200w,
                      {{ media | image_url: width: 1600 }} 1600w"
              sizes="(max-width:960px) 100vw, 55vw"
              alt="{{ media.alt | default: product.title | escape }}"
              width="{{ media.width }}" height="{{ media.height }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- endcapture -%}
      {%- if gallery != blank -%}
        {{ gallery }}
      {%- else -%}
        <div class="gal__f"><div class="ph--lg"><span>No image</span></div></div>
      {%- endif -%}
    </div>

    <!-- buy column -->
    <div class="buy">
      <p class="mono buy__ref">
        {{ product.type }}{% if product.vendor != blank %} · {{ product.vendor }}{% endif %}
      </p>
      <h1 class="buy__h">{{ product.title }}</h1>

      {%- assign pv = product.selected_or_first_available_variant -%}
      <p class="buy__price" id="price">
        {{ pv.price | money }}
        {%- if pv.compare_at_price > pv.price -%}
          <s id="was" style="color:var(--steel);margin-left:8px">{{ pv.compare_at_price | money }}</s>
        {%- endif -%}
      </p>
      <p class="buy__ship">Free US shipping · arrives in 8–14 business days</p>

      {%- comment -%} Specification sheet — only rows that actually have values {%- endcomment -%}
      {%- capture rows -%}
        {%- if m.gsm != blank -%}
          <div class="sheet__row"><span class="sheet__k">Fabric weight</span><span class="sheet__v"><em>{{ m.gsm }} g/m²</em></span></div>
        {%- endif -%}
        {%- if m.composition != blank -%}
          <div class="sheet__row"><span class="sheet__k">Composition</span><span class="sheet__v">{{ m.composition }}</span></div>
        {%- endif -%}
        {%- if m.rise != blank -%}
          <div class="sheet__row"><span class="sheet__k">Rise</span><span class="sheet__v">{{ m.rise }}</span></div>
        {%- endif -%}
        {%- if m.inseam != blank -%}
          <div class="sheet__row"><span class="sheet__k">Inseam</span><span class="sheet__v">{{ m.inseam }}</span></div>
        {%- endif -%}
        {%- if m.seams != blank -%}
          <div class="sheet__row"><span class="sheet__k">Seams</span><span class="sheet__v">{{ m.seams }}</span></div>
        {%- endif -%}
        {%- if m.gusset != blank -%}
          <div class="sheet__row"><span class="sheet__k">Gusset</span><span class="sheet__v">{{ m.gusset }}</span></div>
        {%- endif -%}
        {%- if m.opacity != blank -%}
          <div class="sheet__row"><span class="sheet__k">Opacity</span><span class="sheet__v">{{ m.opacity }}</span></div>
        {%- endif -%}
        {%- if m.care != blank -%}
          <div class="sheet__row"><span class="sheet__k">Care</span><span class="sheet__v">{{ m.care }}</span></div>
        {%- endif -%}
      {%- endcapture -%}

      {%- if rows != blank -%}
        <div class="sheet">
          {{ rows }}
          <p class="sheet__src">Figures taken from the mill's specification sheet, unedited.</p>
        </div>
      {%- endif -%}

      <!-- add to cart -->
      {%- form 'product', product, id: 'hivolt-form' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="opt">
              <div class="opt__lab">
                <span class="mono">{{ option.name }}</span>
                {%- if option.name == 'Size' -%}
                  {%- assign sg = pages['size-guide'] -%}
                  {%- if sg != blank and sg.handle != blank -%}<a href="{{ sg.url }}">Size guide</a>{%- endif -%}
                {%- endif -%}
              </div>
              <div class="sizes">
                {%- for value in option.values -%}
                  <button type="button" class="size js-opt"
                          data-index="option{{ option.position }}" data-value="{{ value | escape }}"
                          aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <select name="id" id="variant-select" class="visually-hidden" aria-label="Select size">
          {%- for v in product.variants -%}
            <option value="{{ v.id }}"
                    {% if v == product.selected_or_first_available_variant %}selected{% endif %}
                    {% unless v.available %}disabled{% endunless %}
                    data-price="{{ v.price | money }}"
                    data-was="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money }}{% endif %}">
              {{ v.title }}
            </option>
          {%- endfor -%}
        </select>

        {%- assign sel_v = product.selected_or_first_available_variant -%}
        <button type="submit" class="btn add" id="add"
                {% unless sel_v.available %}disabled{% endunless %}>
          {%- if sel_v.available -%}
            Add to bag — <span id="btn-price">{{ product.selected_or_first_available_variant.price | money }}</span>
          {%- else -%}
            Sold out
          {%- endif -%}
        </button>
      {%- endform -%}

      <div class="assure">
        <ul>
          <li><b>Ship</b><span>Free, no minimum. Dispatched from Illinois, tracked. 8–14 business days.</span></li>
          {%- comment -%}
            This said "including worn and washed" until 2026-08-12. The binding
            refund policy says the opposite — unworn, tags on, and training in
            it or washing it puts it outside the window. Advertising a promise
            the policy denies is the one defect a customer discovers only at
            the moment you refuse their return, so the copy moves to the
            policy rather than the policy being quietly ignored.
          {%- endcomment -%}
          <li><b>Return</b><span>60 days, unworn with tags. Free prepaid US label, no restocking fee.</span></li>
          <li><b>Pay</b><span>Shopify Checkout. Card details never touch our servers.</span></li>
        </ul>
      </div>

      <div class="disc">
        {%- comment -%}
          This paragraph used to say the photographs were the supplier's studio
          images AND that "we don't publish pictures we haven't taken" — which
          cannot both be true, since a supplier's photograph is by definition
          one HIVOLT did not take. On a store whose entire proposition is that
          its claims are checkable, a contradiction a reader can spot in one
          sentence is expensive. The honest version of the claim is about whose
          garment is pictured, not about who held the camera.
        {%- endcomment -%}
        <p><strong>What this product is</strong>
          A manufacturer blank, selected and specified by us — not made in a HIVOLT factory.
          The photographs above are the supplier's studio images of this exact garment —
          not our own photography, and not a stand-in for something similar. There is no
          logo printed on it.</p>
      </div>

      {%- if product.description != blank -%}
        <div class="rte" style="margin-top:24px">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Related — from the same collection, never `collections.all` {%- endcomment -%}
  {%- if collection and collection.products_count > 1 -%}
    <section class="cat wrap">
      <div class="sec__head">
        <h2 class="sec__h">More in {{ collection.title }}</h2>
        <span class="mono">{{ collection.products_count }} styles</span>
      </div>
      <div class="grid">
        {%- assign shown = 0 -%}
        {%- for p in collection.products limit: 8 -%}
          {%- if p.id != product.id and shown < 4 -%}
            {%- assign shown = shown | plus: 1 -%}
            <a class="item" href="{{ p.url }}">
              <div class="item__fig">
                {%- if p.metafields.spec.gsm != blank -%}
                  <span class="item__gsm">{{ p.metafields.spec.gsm }}</span>
                {%- endif -%}
                {%- if p.featured_image -%}
                  <img src="{{ p.featured_image | image_url: width: 800 }}"
                       alt="{{ p.featured_image.alt | default: p.title | escape }}"
                       width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}"
                       loading="lazy">
                {%- else -%}
                  <div class="ph"><span>No image</span></div>
                {%- endif -%}
              </div>
              <div class="item__body">
                <h3 class="item__name">{{ p.title }}</h3>
                <p class="item__meta">{{ p.metafields.spec.composition | default: p.type }}</p>
                <div class="item__foot">
                  <span class="item__price">{{ p.price | money }}</span>
                  <span class="item__buy">View</span>
                </div>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

{%- comment -%} Product + Breadcrumb structured data {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
  {%- if product.selected_or_first_available_variant.sku != blank %}
  "mpn": {{ product.selected_or_first_available_variant.sku | json }},
  {%- endif %}
  "brand": {"@type":"Brand","name":"HIVOLT"},
  "itemCondition": "https://schema.org/NewCondition",
  {%- comment -%}
    material and the fabric-weight property are emitted only where the spec
    metafield actually holds a value. Google reads material for apparel; the
    weight goes in additionalProperty because schema.org "weight" means the
    mass of the item, not the mass per square metre of its fabric — using it
    for g/m² would be a wrong statement in a machine-readable field.
  {%- endcomment -%}
  {%- if product.metafields.spec.composition != blank %}
  "material": {{ product.metafields.spec.composition | json }},
  {%- endif %}
  {%- comment -%}
    Colour, size and audience are all read by Google for apparel, and all three
    were already in the store — colour and size as variant options, gender as
    an mm-google-shopping metafield. Those metafields were built for the
    Merchant Center feed and were invisible to the organic crawler, so the same
    facts are now stated in both places.

    Captured rather than piped straight from the metafield: the namespace
    contains a hyphen, so it can only be reached by bracket lookup, and
    capturing forces the drop to render as its plain value before it is
    JSON-encoded.
  {%- endcomment -%}
  {%- assign v_color = '' -%}
  {%- assign v_size = '' -%}
  {%- for opt in product.options_with_values -%}
    {%- assign oname = opt.name | downcase -%}
    {%- if oname == 'color' or oname == 'colour' -%}
      {%- assign v_color = opt.selected_value -%}
    {%- elsif oname == 'size' -%}
      {%- assign v_size = opt.selected_value -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if v_color != blank %}
  "color": {{ v_color | json }},
  {%- endif %}
  {%- if v_size != blank %}
  "size": {{ v_size | json }},
  {%- endif %}
  {%- capture gender_str -%}{{ product.metafields['mm-google-shopping']['gender'] }}{%- endcapture -%}
  {%- assign gender_str = gender_str | strip -%}
  {%- if gender_str != blank %}
  "audience": {
    "@type": "PeopleAudience",
    "suggestedGender": {{ gender_str | json }}
  },
  {%- endif %}
  {%- if product.metafields.spec.gsm != blank %}
  "additionalProperty": [{
    "@type": "PropertyValue",
    "name": "Fabric weight",
    "value": {{ product.metafields.spec.gsm | json }},
    "unitCode": "GM",
    "unitText": "g/m²"
  }],
  {%- endif %}
  {%- comment -%}
    Every image, not just the featured one. Google picks the best aspect ratio
    for a given surface from the list it is given, so sending one image means
    it has nothing to pick from — and Shopping listings prefer merchants who
    supply more than a single shot.
  {%- endcomment -%}
  {%- if product.images.size > 0 %}
  "image": [
    {%- for img in product.images limit: 10 -%}
      {{ img | image_url: width: 1200 | prepend: "https:" | json }}
      {%- unless forloop.last %},{% endunless -%}
    {%- endfor -%}
  ],
  {%- endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ product.price | divided_by: 100.0 | json }},
    {%- comment -%}
      Rolling one year out. Google treats a missing priceValidUntil as a reason
      to age out the offer, and a date in the past suppresses the rich result
      outright — so this must always be in the future, never a fixed literal.
    {%- endcomment -%}
    "priceValidUntil": {{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' | json }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "seller": {"@type":"Organization","name":"HIVOLT"},
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {"@type":"MonetaryAmount","value":0,"currency":"USD"},
      "shippingDestination": {"@type":"DefinedRegion","addressCountry":"US"}
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "US",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 60,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  }
}
</script>

{%- comment -%}
  Breadcrumb structured data, mirroring the visible nav at the top of the page
  from the same `crumb`. The comment above the Product block has promised a
  breadcrumb since this template was written, but none was ever emitted —
  product pages were the only templates without one, and they are the pages
  that actually rank.

  The product crumb points at the canonical /products/<handle> rather than
  `product.url`, which carries the collection prefix when one is in scope.
  A breadcrumb that disagrees with the canonical tag is worse than none.
{%- endcomment -%}
{%- assign canon = shop.url | append: '/products/' | append: product.handle -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},
    {%- if crumb.handle %}
    {"@type":"ListItem","position":2,"name":{{ crumb.title | json }},"item":{{ shop.url | append: crumb.url | json }}},
    {"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ canon | json }}}
    {%- else %}
    {"@type":"ListItem","position":2,"name":{{ product.title | json }},"item":{{ canon | json }}}
    {%- endif %}
  ]
}
</script>

<script>
(function(){
  var sel=document.getElementById('variant-select');
  if(!sel) return;
  var price=document.getElementById('price'), btnPrice=document.getElementById('btn-price');

  document.querySelectorAll('.js-opt').forEach(function(b){
    b.addEventListener('click',function(){
      // mark this value selected within its own option group
      b.parentNode.querySelectorAll('.js-opt').forEach(function(x){x.setAttribute('aria-pressed','false')});
      b.setAttribute('aria-pressed','true');

      // collect the chosen value for every option group, in order
      var chosen=[];
      document.querySelectorAll('.opt .sizes').forEach(function(group){
        var on=group.querySelector('.js-opt[aria-pressed="true"]');
        if(on) chosen.push(on.dataset.value);
      });
      var want=chosen.join(' / ');

      for(var i=0;i<sel.options.length;i++){
        if(sel.options[i].text.trim()===want){
          sel.selectedIndex=i;
          sel.dispatchEvent(new Event('change',{bubbles:true}));
          var p=sel.options[i].dataset.price;
          if(price&&p) price.firstChild.nodeValue=p+' ';
          // Keep the strikethrough on the same variant as the price beside it.
          var was=document.getElementById('was'), w=sel.options[i].dataset.was;
          if(was){ if(w){ was.textContent=w; was.hidden=false; } else { was.hidden=true; } }
          if(btnPrice&&p) btnPrice.textContent=p;
          var add=document.getElementById('add');
          if(add){
            var out=sel.options[i].disabled;
            add.disabled=out;
            // Rebuild the label both ways. Assigning textContent destroys the
            // #btn-price span, so the old code could go to "Sold out" and never
            // come back when the shopper picked an in-stock size.
            add.innerHTML = out
              ? 'Sold out'
              : 'Add to bag \u2014 <span id="btn-price">'+(p||'')+'</span>';
            btnPrice=document.getElementById('btn-price');
          }
          break;
        }
      }
    });
  });
})();
</script>
