{%- comment -%}
  HIVOLT — layout/password.liquid
  ──────────────────────────────
  Shopify renders templates/password.liquid inside THIS layout, not inside
  layout/theme.liquid. A store with password protection enabled and no
  password layout falls back to Shopify's generic one, which carries none of
  the brand — so the first thing anyone sees while the store is paused is a
  default page with a different typeface and no explanation.

  Deliberately standalone rather than reusing the main shell: the masthead,
  footer, cart link and full navigation would all point at pages a locked-out
  visitor cannot reach. It links assets/hivolt.css for the design tokens and
  nothing else.

  {{ content_for_header }} is required by Shopify and must stay.
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif %}
  <title>{{ shop.name | escape }}</title>
  <meta name="description" content="{{ shop.description | default: shop.name | strip_html | escape }}">
  {%- comment -%} A locked store has nothing to index. {%- endcomment -%}
  <meta name="robots" content="noindex,nofollow">
  {{ content_for_header }}
  {{ 'hivolt.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-password">
  <main id="main" class="pw">
    {{ content_for_layout }}
  </main>
</body>
</html>
