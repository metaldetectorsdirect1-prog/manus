{%- comment -%}
  HIVOLT — activate account
  ─────────────────────────
  Installs as templates/customers/activate_account.liquid.
  Shopify renders this template on the invitation link sent when an account is
  created for a customer in the admin.

  Requires, from layout/theme.liquid:
      'hivolt.css'  | asset_url | stylesheet_tag
      'account.css' | asset_url | stylesheet_tag

  No <main> element: layout/theme.liquid already provides one.

  Both buttons are submits inside the one activate_customer_password form:
  name="activate" sets the password and opens the account, name="decline"
  throws the invitation away. Declining is not hidden, and is not styled as a
  mistake.
{%- endcomment -%}

<nav class="crumb wrap" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    <li aria-current="page">Activate account</li>
  </ol>
</nav>

<section class="acct acct--solo wrap">

  <div class="sec__head">
    <h1 class="sec__h">Activate account</h1>
    <span class="mono">Invitation</span>
  </div>

  <p class="acct__lede">
    An account was opened for {{ email }}. Set a password to use it, or decline
    the invitation and it is thrown away.
  </p>

  {%- form 'activate_customer_password', novalidate: 'novalidate' -%}

    {%- assign pass_bad = false -%}
    {%- if form.errors contains 'password' or form.errors contains 'form' -%}
      {%- assign pass_bad = true -%}
    {%- endif -%}
    {%- assign conf_bad = false -%}
    {%- if form.errors contains 'password_confirmation' -%}
      {%- assign conf_bad = true -%}
    {%- endif -%}

    {%- if form.errors -%}
      <div class="frm__alert" role="alert" tabindex="-1">
        <p class="frm__alert-h">The account was not activated. Fix the following, then send it again.</p>
        <ul class="frm__alert-l">
          {%- for field in form.errors -%}
            <li>
              {%- case field -%}
                {%- when 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- when 'password' -%}
                  <a href="#ActivatePassword">Password — {{ form.errors.messages[field] }}.</a>
                {%- when 'password_confirmation' -%}
                  <a href="#ActivateConfirm">Confirmation — {{ form.errors.messages[field] }}. Type the same password in both fields.</a>
                {%- else -%}
                  {{ form.errors.translated_fields[field] | capitalize }} — {{ form.errors.messages[field] }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
        <div class="frm__raw">{{ form.errors | default_errors }}</div>
      </div>
    {%- endif -%}

    <div class="fld{% if pass_bad %} fld--bad{% endif %}">
      <label class="fld__lab mono" for="ActivatePassword">Password</label>
      <input
        class="fld__in"
        type="password"
        id="ActivatePassword"
        name="customer[password]"
        autocomplete="new-password"
        required
        {% if pass_bad %}aria-invalid="true" aria-describedby="ActivatePassword-err"{% endif %}>
      {%- if pass_bad -%}
        <p class="fld__err" id="ActivatePassword-err">Choose a different password and type it again.</p>
      {%- endif -%}
    </div>

    <div class="fld{% if conf_bad %} fld--bad{% endif %}">
      <label class="fld__lab mono" for="ActivateConfirm">Type it again</label>
      <input
        class="fld__in"
        type="password"
        id="ActivateConfirm"
        name="customer[password_confirmation]"
        autocomplete="new-password"
        required
        {% if conf_bad %}aria-invalid="true" aria-describedby="ActivateConfirm-err"{% endif %}>
      {%- if conf_bad -%}
        <p class="fld__err" id="ActivateConfirm-err">The two passwords must match, character for character.</p>
      {%- endif -%}
    </div>

    <div class="frm__acts">
      <button type="submit" name="activate" class="btn">Activate account</button>
      <button type="submit" name="decline" class="btn btn--ghost">Decline invitation</button>
    </div>
  {%- endform -%}

  <div class="acct__alt">
    <h2 class="acct__sub">What activating changes</h2>
    <div class="sheet">
      <div class="sheet__row"><span class="sheet__k">Orders</span><span class="sheet__v">Past and future orders on this email are listed</span></div>
      <div class="sheet__row"><span class="sheet__k">Addresses</span><span class="sheet__v">Saved for checkout, editable at any time</span></div>
      <div class="sheet__row"><span class="sheet__k">Declining</span><span class="sheet__v">Removes the invitation, keeps the orders</span></div>
    </div>
  </div>

</section>

<script>
(function(){
  var alert = document.querySelector('.frm__alert');
  if (alert) alert.focus();
})();
</script>
