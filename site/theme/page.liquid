{%- comment -%}
  HIVOLT — templates/page.liquid
  ─────────────────────────────
  The generic page template. Every page in the admin that has NOT been given an
  alternate template renders through this file, so it has to stand up on its own
  with nothing but a title and a body of admin-entered HTML.

  Renders inside layout/theme.liquid, which supplies <main>, the ticker, the
  masthead and the footer. No <main> here — nesting one inside another is
  invalid HTML.

  Requires two stylesheets linked from layout/theme.liquid:

      {{ 'hivolt.css' | asset_url | stylesheet_tag }}
      {{ 'hivolt-pages.css' | asset_url | stylesheet_tag }}

  The body is wrapped in .rte, which holds the measure at 68ch and styles the
  elements the rich-text editor can emit — headings, lists, links, quotes,
  tables, images. Tables get their own horizontal scroll, because the editor can
  produce one wider than a phone and the page must never scroll sideways.
{%- endcomment -%}

<nav class="crumb wrap" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    <li aria-current="page">{{ page.title | escape }}</li>
  </ol>
</nav>

<article class="pg pg--solo wrap">

  <header class="sec__head">
    <h1 class="sec__h">{{ page.title | escape }}</h1>
  </header>

  {%- if page.content != blank -%}
    <div class="rte">
      {{ page.content }}
    </div>
  {%- else -%}
    <div class="rte">
      <p>Nothing has been published on this page yet.</p>
      <p>
        <a href="{{ routes.all_products_collection_url }}">The catalogue</a> is the
        best place to go from here — every style there lists its fibre composition
        and fabric weight.
      </p>
    </div>
  {%- endif -%}

</article>
