{%- comment -%}
  HIVOLT — templates/password.liquid
  ─────────────────────────────────
  Renders inside layout/password.liquid.

  Two forms, and they are not interchangeable:

    form 'storefront_password'  — the actual unlock. Shopify sets
                                  form.errors when the password is wrong.
    form 'customer'             — the notify list, tagged so these signups are
                                  distinguishable from Circuit members later.

  The error state is a real list with role="alert", not a red border, because
  a colour change is invisible to a screen reader.

  No launch date and no countdown. The store has no committed launch date, so
  either would be invented — and check-liquid.py rejects countdowns outright.
{%- endcomment -%}

<section class="pw__in">

  <p class="mono pw__eyebrow">{{ shop.name | escape }}</p>

  <h1 class="pw__h">Closed<br>for the<br><em>moment.</em></h1>

  <div class="rte rte--tight pw__body">
    {%- if shop.password_message != blank -%}
      {{ shop.password_message }}
    {%- else -%}
      <p>
        The store is temporarily locked. Nothing is wrong with your link — it
        will open again shortly.
      </p>
    {%- endif -%}
  </div>

  {%- comment -%} ── notify list ─────────────────────────────── {%- endcomment -%}
  {%- form 'customer', id: 'pw-notify' -%}
    {%- if form.posted_successfully? -%}
      <div class="cf__ok" tabindex="-1" role="status">
        <p class="mono cf__ok-h">You're on the list</p>
        <p class="cf__ok-b">We'll email you once when the store reopens. Nothing else.</p>
      </div>
    {%- endif -%}

    {%- if form.errors -%}
      <div class="cf__err" tabindex="-1" role="alert">
        <p class="mono cf__err-h">That didn't go through</p>
        <ul class="cf__err-l">
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                {{ form.errors.translated_fields[field] }} — {{ form.errors.messages[field] }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="cf pw__cf">
      <input type="hidden" name="contact[tags]" value="newsletter, reopening">
      <div class="cf__f">
        <label class="cf__l" for="pw-email">Email me when it reopens</label>
        <input class="cf__in" type="email" id="pw-email" name="contact[email]"
               autocomplete="email" required placeholder="you@example.com"
               value="{{ form.email }}">
      </div>
      <button class="btn cf__go" type="submit">Notify me</button>
      <p class="cf__note">One email, when the store reopens. Unsubscribe from any message.</p>
    </div>
  {%- endform -%}

  {%- comment -%} ── the unlock ──────────────────────────────── {%- endcomment -%}
  <div class="pw__enter">
    <details class="pw__det">
      <summary class="mono">Have the password?</summary>

      {%- form 'storefront_password', id: 'pw-unlock' -%}
        {%- if form.errors -%}
          <div class="cf__err" tabindex="-1" role="alert">
            <p class="mono cf__err-h">Wrong password</p>
            <ul class="cf__err-l">
              {%- for field in form.errors -%}
                <li>{{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="cf">
          <div class="cf__f">
            <label class="cf__l" for="pw-pass">Password</label>
            <input class="cf__in" type="password" id="pw-pass" name="password"
                   autocomplete="current-password" required
                   {% if form.errors %}autofocus{% endif %}>
          </div>
          <button class="btn btn--ghost cf__go" type="submit">Enter</button>
        </div>
      {%- endform -%}
    </details>
  </div>

  <p class="pw__foot mono">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
    {%- if shop.email != blank %} · {{ shop.email }}{% endif -%}
  </p>

</section>
