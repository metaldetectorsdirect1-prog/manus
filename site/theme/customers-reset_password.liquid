{%- comment -%}
  HIVOLT — set a new password
  ───────────────────────────
  Installs as templates/customers/reset_password.liquid.
  Shopify renders this template on the one-time link emailed by the recover
  form on the login page.

  Requires, from layout/theme.liquid:
      'hivolt.css'  | asset_url | stylesheet_tag
      'account.css' | asset_url | stylesheet_tag

  No <main> element: layout/theme.liquid already provides one.

  The password rules belong to Shopify, so this page states none of its own.
  Whatever comes back in form.errors is what the customer has to satisfy.
{%- endcomment -%}

<nav class="crumb wrap" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    <li><a href="{{ routes.account_login_url }}">Sign in</a></li>
    <li aria-current="page">New password</li>
  </ol>
</nav>

<section class="acct acct--solo wrap">

  <div class="sec__head">
    <h1 class="sec__h">New password</h1>
    <span class="mono">Step 2 of 2</span>
  </div>

  <p class="acct__lede">
    Set the password for {{ email }}. The link that brought you here works once.
  </p>

  {%- form 'reset_customer_password', novalidate: 'novalidate' -%}

    {%- assign pass_bad = false -%}
    {%- if form.errors contains 'password' or form.errors contains 'form' -%}
      {%- assign pass_bad = true -%}
    {%- endif -%}
    {%- assign conf_bad = false -%}
    {%- if form.errors contains 'password_confirmation' -%}
      {%- assign conf_bad = true -%}
    {%- endif -%}

    {%- if form.errors -%}
      <div class="frm__alert" role="alert" tabindex="-1">
        <p class="frm__alert-h">The password was not changed. Fix the following, then send it again.</p>
        <ul class="frm__alert-l">
          {%- for field in form.errors -%}
            <li>
              {%- case field -%}
                {%- when 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- when 'password' -%}
                  <a href="#ResetPassword">Password — {{ form.errors.messages[field] }}.</a>
                {%- when 'password_confirmation' -%}
                  <a href="#ResetConfirm">Confirmation — {{ form.errors.messages[field] }}. Type the same password in both fields.</a>
                {%- else -%}
                  {{ form.errors.translated_fields[field] | capitalize }} — {{ form.errors.messages[field] }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
        <div class="frm__raw">{{ form.errors | default_errors }}</div>
      </div>
    {%- endif -%}

    <div class="fld{% if pass_bad %} fld--bad{% endif %}">
      <label class="fld__lab mono" for="ResetPassword">New password</label>
      <input
        class="fld__in"
        type="password"
        id="ResetPassword"
        name="customer[password]"
        autocomplete="new-password"
        required
        {% if pass_bad %}aria-invalid="true" aria-describedby="ResetPassword-err"{% endif %}>
      {%- if pass_bad -%}
        <p class="fld__err" id="ResetPassword-err">Choose a different password and type it again.</p>
      {%- endif -%}
    </div>

    <div class="fld{% if conf_bad %} fld--bad{% endif %}">
      <label class="fld__lab mono" for="ResetConfirm">Type it again</label>
      <input
        class="fld__in"
        type="password"
        id="ResetConfirm"
        name="customer[password_confirmation]"
        autocomplete="new-password"
        required
        {% if conf_bad %}aria-invalid="true" aria-describedby="ResetConfirm-err"{% endif %}>
      {%- if conf_bad -%}
        <p class="fld__err" id="ResetConfirm-err">The two passwords must match, character for character.</p>
      {%- endif -%}
    </div>

    <div class="frm__acts">
      <button type="submit" class="btn">Set password</button>
      <a class="frm__link" href="{{ routes.account_login_url }}">Back to sign in</a>
    </div>
  {%- endform -%}

</section>

<script>
(function(){
  var alert = document.querySelector('.frm__alert');
  if (alert) alert.focus();
})();
</script>
